{
  "name": "rugby-tactics-db",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Source-aware rugby tactics knowledge for people and machines",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "check": "npm run check:data && npm run validate && npm test && npm run build",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "assemble": "node scripts/assemble.mjs",
    "check:data": "node scripts/assemble.mjs --check",
    "check:versions": "node scripts/check-versions.mjs",
    "audit:history": "node scripts/audit-history.mjs"
  }
}
