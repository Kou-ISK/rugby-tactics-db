{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kou-isk.github.io/rugby-tactics-db/schemas/dataset.schema.json",
  "title": "Rugby Tactics DB dataset v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "accessed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "coaching",
              "law"
            ]
          },
          "formats": {
            "type": "array",
            "items": {
              "enum": [
                "XV",
                "sevens"
              ]
            },
            "minItems": 1
          },
          "rights": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "publisher",
          "accessed",
          "kind",
          "formats",
          "rights"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rtk:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "name": {
            "type": "object",
            "properties": {
              "ja": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ja",
              "en"
            ],
            "additionalProperties": false
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "language": {
                  "enum": [
                    "ja",
                    "en"
                  ]
                },
                "kind": {
                  "enum": [
                    "translation",
                    "synonym",
                    "contextual"
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label",
                "language",
                "kind",
                "note"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "side": {
            "enum": [
              "attack",
              "defence",
              "both"
            ]
          },
          "level": {
            "enum": [
              "system",
              "shape",
              "move",
              "principle",
              "skill",
              "phase"
            ]
          },
          "formats": {
            "type": "array",
            "items": {
              "enum": [
                "XV",
                "sevens"
              ]
            },
            "minItems": 1
          },
          "summary": {
            "type": "object",
            "properties": {
              "ja": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ja",
              "en"
            ],
            "additionalProperties": false
          },
          "intent": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "applicability": {
            "type": "object",
            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "limits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "conditions",
              "limits"
            ],
            "additionalProperties": false
          },
          "mechanics": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "editorial-model"
                ]
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "task": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claimRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "task",
                    "claimRefs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "positioning": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subject": {
                      "type": "string",
                      "minLength": 1
                    },
                    "relation": {
                      "enum": [
                        "inside-of",
                        "outside-of",
                        "behind",
                        "ahead-of",
                        "near",
                        "across-width",
                        "connected-to"
                      ]
                    },
                    "object": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claimRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "subject",
                    "relation",
                    "object",
                    "note",
                    "claimRefs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "sequence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "actor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "action": {
                      "enum": [
                        "carry",
                        "pass",
                        "support",
                        "align",
                        "press",
                        "drift",
                        "track",
                        "scan",
                        "kick",
                        "recover",
                        "recycle"
                      ]
                    },
                    "trigger": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claimRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "actor",
                    "action",
                    "trigger",
                    "description",
                    "claimRefs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "decisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cue": {
                      "type": "string",
                      "minLength": 1
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "action": {
                            "type": "string",
                            "minLength": 1
                          },
                          "when": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "action",
                          "when"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 2
                    },
                    "uncertainty": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claimRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "cue",
                    "options",
                    "uncertainty",
                    "claimRefs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "status",
              "roles",
              "positioning",
              "sequence",
              "decisions"
            ],
            "additionalProperties": false
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "similarTo",
                    "contrastsWith",
                    "partOf",
                    "enables",
                    "notSameAs"
                  ]
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "target",
                "note"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "variations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "difference": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "context-dependent",
                    "source-described"
                  ]
                }
              },
              "required": [
                "name",
                "difference",
                "status"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      },
                      "support": {
                        "enum": [
                          "direct",
                          "interpretation"
                        ]
                      }
                    },
                    "required": [
                      "source",
                      "locator",
                      "support"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "text",
                "evidence"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "source-backed",
                  "expert-reviewed"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "reviewedBy": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "note",
              "reviewedBy",
              "reviewedAt"
            ],
            "additionalProperties": false
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "execution": {
            "type": "object",
            "properties": {
              "ready": {
                "const": false
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ready",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "aliases",
          "side",
          "level",
          "formats",
          "summary",
          "intent",
          "tags",
          "applicability",
          "mechanics",
          "relationships",
          "variations",
          "claims",
          "review",
          "uncertainties",
          "execution"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "updated",
    "license",
    "sources",
    "concepts"
  ],
  "additionalProperties": false
}
