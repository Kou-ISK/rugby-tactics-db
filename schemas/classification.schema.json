{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kou-isk.github.io/rugby-tactics-db/schemas/classification.schema.json",
  "title": "Rugby Tactics DB strict classification companion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "datasetVersion",
    "datasetSha256",
    "updated",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "datasetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conceptId",
          "canonicalId",
          "kind",
          "naming",
          "rationale",
          "evidence",
          "equivalences"
        ],
        "properties": {
          "conceptId": {
            "type": "string",
            "pattern": "^rtk:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "strategy",
              "system",
              "formation",
              "pattern",
              "tactic",
              "technique",
              "principle",
              "role",
              "situation",
              "coaching-model"
            ]
          },
          "naming": {
            "enum": [
              "source-attested",
              "source-specific",
              "editorial"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "locator"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "equivalences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "labels",
                "scope",
                "rationale",
                "evidence"
              ],
              "properties": {
                "labels": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "locator"
                    ],
                    "properties": {
                      "source": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "canonicalId": {
            "type": "string",
            "pattern": "^rtk:[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
